{
  "name": "@lib/logging",
  "version": "0.0.1",
  "private": true,
  "description": "Structured logging with secret scrubbing, buffered console output and BetterStack forwarding.",
  "type": "module",
  "main": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./logger": "./src/logger/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./pipeline": "./src/pipeline/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings && depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@loglayer/transport": "*",
    "loglayer": "*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "@lib/lint-rules": "workspace:*",
    "@loglayer/transport": "^3.1.0",
    "@types/node": "^22.13.1",
    "loglayer": "^9.2.0",
    "oxlint": "catalog:",
    "dependency-cruiser": "^17.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
