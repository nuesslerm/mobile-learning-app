{
  "name": "@lib/webview-rpc",
  "arch": { "type": "hexagonal-library" },
  "version": "0.0.1",
  "private": true,
  "description": "A typed request/response and event protocol over a WebView's message channel: ids, results, typed errors, timeouts, a protocol version. A pure core, host and page transports for react-native-webview and its web twin, and a loopback double.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings && depcruise src --config .dependency-cruiser.cjs --ignore-known"
  },
  "peerDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "dependency-cruiser": "^17.4.3"
  }
}
