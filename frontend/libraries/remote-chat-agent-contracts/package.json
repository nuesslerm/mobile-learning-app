{
  "name": "@app/remote-chat-agent-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./orchestration": {
      "types": "./src/orchestration/index.ts",
      "default": "./src/orchestration/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
