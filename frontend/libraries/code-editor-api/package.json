{
  "name": "@lib/code-editor-api",
  "arch": { "type": "hexagonal-library" },
  "version": "0.0.1",
  "private": true,
  "description": "One typed, revision-stamped editing contract for the code editor: a pure core, rpc adapters over @lib/webview-rpc, a fake editor and the contract suite.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings && depcruise src --config .dependency-cruiser.cjs --ignore-known"
  },
  "dependencies": {
    "@lib/webview-rpc": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/state": "^6.6.0",
    "@typescript/native": "catalog:",
    "dependency-cruiser": "^17.4.3"
  }
}
