{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "outDir": "./dist/cjs",
    "rootDir": "./src",
    "noEmit": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "tsc-alias": {
    "verbose": true,
    "resolveFullPaths": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
