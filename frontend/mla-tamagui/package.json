{
  "name": "mla-tamagui",
  "description": "Mobile app, shipped as EAS Updates and a web export",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "eas-build-post-install": "install-skia",
    "start": "expo start",
    "web": "EXPO_NO_OPEN=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "build:editor-bundle": "node scripts/cm6-bundle.mjs",
    "check:editor-bundle": "node scripts/cm6-bundle.mjs --check",
    "lint": "oxlint -c ../.oxlintrc.json --deny-warnings --ignore-pattern=features/coding-agent/** --ignore-pattern=features/service-report/** --ignore-pattern=features/settings/** && depcruise app app-shell lib features/leetcode features/tamil-writing features/dashboards --config .dependency-cruiser.cjs --ignore-known",
    "export:web": "EXPO_PUBLIC_DEVICE_LAB=\"${EXPO_PUBLIC_DEVICE_LAB-1}\" EXPO_PUBLIC_LEETCODE_BACKEND_BASE_URL=\"${EXPO_PUBLIC_LEETCODE_BACKEND_BASE_URL:-http://127.0.0.1:8789}\" EXPO_PUBLIC_LEETCODE_BACKEND_TOKEN=\"${EXPO_PUBLIC_LEETCODE_BACKEND_TOKEN:-local-e2e-token}\" EXPO_PUBLIC_AGENT_BASE_URL=\"${EXPO_PUBLIC_AGENT_BASE_URL:-http://127.0.0.1:8787}\" EXPO_PUBLIC_VM_OPS_API_BASE_URL=\"${EXPO_PUBLIC_VM_OPS_API_BASE_URL:-http://127.0.0.1:8091}\" expo export --platform web --output-dir dist ${EXPO_EXPORT_FLAGS-} && node -e \"const fs=require('node:fs'),path=require('node:path');const mark='<!--'+String.fromCharCode(36,33)+'-->',bad=[];const walk=(d)=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=path.join(d,e.name);if(e.isDirectory())walk(f);else if(f.endsWith('.html')&&fs.readFileSync(f,'utf8').includes(mark))bad.push(f)}};walk('dist');if(bad.length){fs.rmSync('dist.rejected',{recursive:true,force:true});fs.renameSync('dist','dist.rejected');process.stderr.write('the static render failed in '+bad.length+' pages (a client-rendered boundary), export moved to dist.rejected: '+bad.join(', ')+'\\\\n');process.exit(1)}fs.copyFileSync('dist/index.html','dist/404.html')\"",
    "export:eas": "expo export $EXPO_EXPORT_PLATFORM_FLAGS --output-dir dist --clear --source-maps $EXPO_EXPORT_FLAGS",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "verify:renders": "node e2e/verify-renders.mjs",
    "verify:charts-spike": "node e2e/verify-charts-spike.mjs",
    "verify:settings": "node e2e/verify-settings.mjs",
    "verify:debug-sheet": "node e2e/verify-debug-sheet.mjs",
    "verify:leetcode": "node e2e/verify-leetcode.mjs",
    "verify:leetcode-shots": "node e2e/capture-leetcode-shots.mjs",
    "verify:tamil": "node e2e/verify-tamil.mjs",
    "e2e:tamil:skia": "EXPO_PUBLIC_TAMIL_CANVAS=skia pnpm run export:web && node e2e/verify-tamil.mjs",
    "glyphs:extract": "tsx scripts/extract-tamil-glyphs.ts",
    "glyphs:preview": "tsx scripts/preview-tamil-glyphs.ts",
    "verify:keyboard-ios": "node e2e/verify-keyboard-platforms.mjs iphone-15-pro",
    "verify:keyboard-android": "node e2e/verify-keyboard-platforms.mjs pixel-8",
    "publish:eas": "node scripts/publish-eas-update.js",
    "test:e2e": "node e2e/run-all.mjs",
    "test:runbook": "node e2e/run-all.mjs",
    "test:unit": "vitest run --passWithNoTests --exclude lib/device-lab/__tests__/platformForks.test.ts --exclude lib/device-lab/__tests__/nativeUiResiduals.test.ts",
    "test:flow": "vitest run --config vitest.flow.config.ts --configLoader runner",
    "test:flow:debug": "vitest run --config vitest.flow.config.ts --configLoader runner tests/flow/inspectorBreakpoint.flow.test.ts",
    "test:flow:skia": "EXPO_PUBLIC_TAMIL_CANVAS=skia vitest run -c vitest.flow.config.ts --configLoader runner tests/flow/tamil-strokes.flow.test.tsx tests/flow/tamilWriting.flow.test.tsx",
    "test:goldens": "wf flow run --goldens",
    "test:goldens:update": "wf flow run --update-goldens",
    "report:capture": "node e2e/capture-report.mjs",
    "report:build": "node e2e/build-report.mjs",
    "report": "node e2e/capture-report.mjs iphone-15-pro && node e2e/capture-report.mjs pixel-8 && node e2e/build-report.mjs",
    "verify:header-menu": "node e2e/verify-header-menu.mjs",
    "verify:sheet": "node e2e/verify-sheet.mjs",
    "verify:dark-theme": "node e2e/verify-dark-theme.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@feature/coding-agent": "workspace:*",
    "@feature/service-report": "workspace:*",
    "@feature/settings": "workspace:*",
    "@lib/app-config": "workspace:*",
    "@lib/app-di": "workspace:*",
    "@lib/logging": "workspace:*",
    "@lib/rn-agentation": "workspace:*",
    "@lib/tamagui-design-system": "workspace:*",
    "@lib/voice-edit-dsl": "workspace:*",
    "@quidone/react-native-wheel-picker": "^1.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tamagui/config": "^2.7.7",
    "@tamagui/core": "^2.7.7",
    "@tamagui/web": "^2.7.7",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "loglayer": "^9.2.0",
    "lucide-react-native": "^1.17.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "sonner-native": "^0.26.4",
    "tamagui": "^2.7.7",
    "victory-native": "42.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "@lib/browser-client": "workspace:*",
    "@lib/eslint-plugin-mobile-learn": "workspace:*",
    "@lib/flow-test-harness": "workspace:*",
    "@tamagui/babel-plugin": "^2.7.7",
    "@tamagui/metro-plugin": "^2.7.7",
    "@types/react": "catalog:",
    "babel-preset-expo": "~57.0.10",
    "dependency-cruiser": "^17.4.3",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "nx": {
    "targets": {
      "test:unit": {
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{workspaceRoot}/docs/solutions/workflow/eas-publishing.md"
          }
        ]
      }
    }
  }
}
