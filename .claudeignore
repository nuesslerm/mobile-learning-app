# What an agent should not read, as opposed to what git should not track.
#
# Every path here is deliberately COMMITTED -- that is the whole point of this
# file over .gitignore. The test each entry has to pass: is the file's content
# machine-generated or serialized such that reading it teaches an agent
# nothing its source does, while costing tens of thousands of tokens?
#
# Sizes below are this repo's real numbers (`git ls-files | xargs du -k`), not
# a generic template's guesses. Anything a rule, hook or skill actually reads
# stays visible, however large -- docs/known-gaps.md (604 KB) is read on
# purpose and is NOT here.

# ==============================================================================
# Transpiled and bundled JavaScript -- 8 MB, every byte generated from TS
# ==============================================================================
# Committed so a fresh checkout has working hooks and a working `wf` before
# `pnpm install` finishes (the bundle-fresh lefthook step enforces that each
# matches its src/). Reading one is reading the same code the sibling src/
# tree holds, with every import inlined and every comment stripped -- and
# wf.js alone is 4 MB. Any grep that hits a bundle also hits its source.
#
# Current bundles, largest first: workflow-cli 4 MB,
# agent-config-sync 880 KB.
# Matched by shape rather than by that list, so a ninth bundle is covered the
# day it lands.
**/bundle/**
**/bundle-opencode/**

# tsc output committed alongside a package (the CLIs resolve consumers through
# dist/, which is why these are tracked at all).
**/dist/**
*.js.map
*.mjs.map
*.cjs.map

# ==============================================================================
# Lockfiles -- resolved hashes and peer-dependency permutations
# ==============================================================================
# 1.7 MB of resolution detail. Version intent lives in package.json and
# pnpm-workspace.yaml's catalog, which stay visible.
pnpm-lock.yaml

# ==============================================================================
# Vendored third-party bundles committed as source
# ==============================================================================
# CodeMirror 6 shipped as one pre-bundled module for the WebView editor.
frontend/*/features/leetcode/code-editor/core/cm6Bundle.ts

# ==============================================================================
# Test snapshots and golden artifacts
# ==============================================================================
# Serialized output, regenerated by the tools that assert on them.
**/__snapshots__/**
*.snap
**/.screenshots/**
artifacts/**

# ==============================================================================
# Generated types and reports
# ==============================================================================
**/__generated__/**
*.generated.json
.conventions-reports/**
coverage/**
*.lcov

# ==============================================================================
# Binary and non-text assets (256 tracked files)
# ==============================================================================
# Nothing a text tool can interpret; a grep hit inside one is noise.
*.png
*.jpg
*.jpeg
*.webp
*.ico
*.ttf
*.otf
*.woff
*.woff2
*.wasm
*.pdf
*.mp3
*.wav
*.mp4
*.mov
*.zip
*.tar.gz

# SVGs are text, but the ones here are exported icon paths, not authored
# markup -- except the design system's own icon set, which is read when
# working on icons.
*.svg
!libraries/design-system/**/*.svg
!frontend/libraries/tamagui-design-system/**/*.svg

# ==============================================================================
# Local caches and build output that happens to sit inside the tree
# ==============================================================================
dist-ios/**
dist-gh-pages/**
.expo/**
.agents/tmp/**
