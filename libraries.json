  "libraries": [
    { "name": "service-kit", "kind": "rust", "path": "backend/service-kit", "registry": "mla" },
    { "name": "telemetry", "kind": "rust", "path": "clis/telemetry", "registry": "mla" },
    { "name": "rca-core", "kind": "rust", "path": "libraries/rca-core", "registry": "mla" },
    { "name": "rca-ladder", "kind": "rust", "path": "libraries/rca-core/plugins/ladder", "registry": "mla" }
  ]
