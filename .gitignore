# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/*
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-error.*

# macOS
.DS_Store
*.pem

# Transient sandbox-proxy CA copy created (and normally trap-cleaned) by
# infra/oracle-cloud/agent-shell/build-and-push.sh
# while a build is in flight -- never meant to be committed.
.sandbox-proxy-ca.crt

# Generated runtime env — composed at deploy from `.env.defaults` + vault
# secrets via `wf secret sync-env --base` (never committed; may hold secrets).
# The committed non-secret base is `.env.defaults` (NOT matched by these).
.env
**/.env

# local env files (per-machine overrides)
.env*.local

# wf app mock enable/disable's per-app env override — machine-state, not a
# static repo default like .env.defaults.
.env.mock

# postinstall's machine-local link to wf's slot registry
/.local/

# typescript
*.tsbuildinfo

# vendored eslint plugin build output (rebuilt on install via prepare)
libraries/*/dist/
libraries/*/dist/**
frontend/libraries/*/dist/
frontend/libraries/*/dist/**
frontend/*/dist/
backend/*/target*/
clis/telemetry/target/
backend/*/dist/
clis/*/dist/
clis/*/dist/**
tooling/browser-harness/dist/
tooling/browser-harness/dist/**
tooling/browser-harness/*/dist/
tooling/browser-harness/*/dist/**
tooling/*/dist/
tooling/*/dist/**
libraries/*/bootstrap/
libraries/*/bootstrap/**
clis/*/bundle/
clis/*/bundle/**
!clis/agent-config-sync/bundle/
!clis/agent-config-sync/bundle/*
!clis/opencode-dispatch/bundle/
!clis/opencode-dispatch/bundle/*

app-example

# Conventions lint reports
**/.conventions-reports/

# generated native folders
/ios
/android
frontend/*/ios/
frontend/*/android/
backend/*/ios/
backend/*/android/

# Storybook generated bootstrap file (per-app)
frontend/*/.storybook/storybook.requires.ts
backend/*/.storybook/storybook.requires.ts

# Env convention — see infra/oracle-cloud/AGENTS.md "Secrets policy":
#   .env.defaults  committed, per-package NON-SECRET config (ports/URLs/modes).
#                  Source of truth.
#   .env           generated at deploy = .env.defaults + vault secrets (via
#                  `wf secret sync-env --base`). GITIGNORED (may hold secrets).
#   .env*.local    gitignored per-machine overrides (highest precedence).
# All secrets live in the vault via `wf secret` — never in a committed file.

# EAS publish marker (per-session, tracks last published commit)

# Browser validation/export artifacts
artifacts/
dist-gh-pages/
dist-agent-test/
screenshots/
.screenshots/

# Metro entry-bundle snapshot (regenerated by Metro when debugging the
# app's entry point). Contains absolute paths baked in from whichever
# machine built it last — committed copies would not survive a worktree
# move or a teammate's clone.
entry-bundle.txt

.claude/.gh-pages-published-sha
.playwright-mcp/

# ESLint cache (generated, not committed)
.eslintcache

# Agent scratch pad — ephemeral large-output offloads, session handoffs
.agents/tmp/*
!.agents/tmp/.gitkeep
**/.agents/tmp/*

# Claude Code's isolated-subagent worktrees: ephemeral checkouts, never committed.
.claude/worktrees/

# AI tool config generated by `pnpm run sync:agent-config` from `.agents/`.
# The files ignored below embed absolute paths; path-free outputs (CLAUDE.md,
# AGENTS.md, .claude/{settings.json,skills,commands,rules}, .opencode/commands)
# are committed so a fresh clone works before any sync runs.
.codex/hooks.json
.opencode/hooks.json
# The opencode CLI binary env-bootstrap downloads (clis/env-bootstrap/src/use-cases/steps/opencode.ts).
.opencode/bin/
.codex/execpolicy/project.rules

opencode.json
.mcp.json
# A plugin's .mcp.json is shipped content, not a generated per-machine file.
!clis/*/.mcp.json
.codex/config.toml


# Playwright test results and reports
/test-results/
test-results

# Flow-golden snapshot HTML (regenerate with FLOW_GOLDENS=1 / wf flow goldens)
.flow-goldens/

# Flow-test run report (report.json, index.html, debug.jsonl), rewritten by every flow run
.flow-report/

# Telegram bot runtime state (machine-specific session/worktree tracking)
.bot-state/

# Dev-mode server mock activation state (which backend/<name>-mock processes
# are running in this worktree). See
# docs/superpowers/plans/2026-07-12-001-feat-dev-server-mocks-contract-tests-plan.md
.wf-app-mocks

# EAS Simulator writes a session id + daemon TOKEN here.
.env.eas-simulator

# Each browser check copies the web export into its own temp server root. A
# crashed run leaves one behind, and `git add -A` then commits the whole export.
.serve-tmp-*/

# Screenshot walkthrough output. Regenerate with `pnpm --filter mla-tamagui run
# report`; the published Artifact is the durable copy, not this directory.
frontend/mla-tamagui/.report/

__pycache__/

# Gemini Gem context sync (wf knowledge index --gemini)
repomix-output.md
# wf knowledge index --gemini's scratch: skeleton, ARCHITECTURE.md, pack and bundle. Regenerable
# from source; docs/gemini-context/manifest.json (committed) records the last upload.
.gemini-context-cache/
# the drafting model may write its document into the checkout it is asked from; a stray file there dirties the tree and the build cache then refuses to write
/ARCHITECTURE.md

# vm-puppeteer session worktrees touch this marker on every job
.session-last-active

# Nx: the local task cache and its workspace data
.nx/
# e2e results Nx restores on a cache hit
.e2e-results/
# the runner's kept checkout still holds the record older e2e jobs tee'd here (they write it under RUNNER_TEMP now)
/e2e-tests.jsonl
.superpowers/
