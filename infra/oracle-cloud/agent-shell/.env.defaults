# Non-secret config (COMMITTED). Runtime `.env` = this + vault secrets via
#   wf secret sync-env --for agent-shell --base .env.defaults --out .env
# Secrets (from the vault, NEVER here): VM_OPS_API_AUTH_TOKEN (redeploy-app's
#   bearer token for vm-ops-api's OWN routes -- redeploy,
#   /agent-shell/credentials -- distinct from VM_GATEWAY_AUTH_SEED, which only
#   gates vm-gateway's Funnel), VM_GATEWAY_AUTH_SEED,
#   VNC_AUTH_TRIGGER_SECRET + VNC_AUTH_OWNER_CHAT_ID (for `wf secret login
#   remote-login <tool>` -- the same guard headers vnc-auth-session's own
#   listener already trusts, reused here rather than minted new). No SSH
#   public-key vault secrets are wired into this container -- authorized_keys
#   is sourced entirely from SSHID_URL below, a deliberate single-source
#   decision. ORACLE_DEPLOY_SSH_PUBLIC_KEY / BREAK_GLASS_SSH_PUBLIC_KEY still
#   exist in the vault for the VM host's own Terraform var, just not here.
#   DOCKERHUB_TOKEN (the one Docker Hub PAT for every build and push; required, an
#   unset value aborts the deploy). VM_PROVISION_GITHUB_TOKEN (a Contents:Read-only PAT for
#   this repo, the SAME one vm-ops-api already uses for its own
#   raw.githubusercontent.com fetches, reused rather than duplicated) --
#   optional; without it, the e2e-*.sh scripts' `git clone` of this private
#   repo fails with a plain auth error.
#   DOCKERHUB_USERNAME is not secret
#   (visible in every public image reference already), so it's a plain
#   default below, not a vault secret.
DOCKERHUB_USERNAME=nuesslerm
# HOST_LABEL is per-VM and appended by deploy.sh, not set here. TS_VM_AUTH_KEY
# is required (vault secret) -- this app joins the tailnet like every other
# app, purely so it can resolve vm-ops-api-${HOST_LABEL} via MagicDNS for
# redeploy-app; it has no public Funnel surface of its own beyond the raw
# TCP-forwarded SSH port (see docker-compose.prod.yml).
#
# SSHID_URL: not secret -- a public identity-keys endpoint (same shape as
# GitHub's github.com/<user>.keys: plain text, one pubkey per line), fetched
# live by entrypoint.sh on every container start rather than pasted as a
# static vault value. That's deliberate: a key added/rotated at the URL
# takes effect on the next redeploy with no vault write and no rebuild.
SSHID_URL=https://sshid.io/nuesslerm

# AGENT_SHELL_E2E_SSH_PUBLIC_KEY: not secret (a public key) -- the ONE
# deliberate exception to "SSHID_URL only" above, a narrowly-scoped
# machine-only test identity for an agent session's automated/exploratory
# e2e checks over SSH, matched by a vault-held private half
# (AGENT_SHELL_E2E_SSH_PRIVATE_KEY) resolved by whatever drives those
# checks. NOT a second personal identity -- see entrypoint.sh's own comment.
# Base64-encoded (entrypoint.sh decodes it), NOT the raw "ssh-ed25519 <b64>
# <comment>" line -- confirmed live that the raw form, which contains
# spaces, gets silently dropped somewhere in the .env-synthesis/provisioning
# pipeline before it reaches the container's environment (every other var
# in this file is a single space-free token; this was the first one that
# wasn't, and it broke). A single opaque token sidesteps whichever stage
# does this rather than chasing it through provision-apps.js.
AGENT_SHELL_E2E_SSH_PUBLIC_KEY=c3NoLWVkMjU1MTkgQUFBQUMzTnphQzFsWkRJMU5URTVBQUFBSUVKZnljU2poRTdkUlRubENCOG1ORTk3ZGdVekw4Nk4xOEt0MHBTRkZZTVMgYWdlbnQtc2hlbGwtZTJlLXRlc3Q=

# BETTERSTACK_OTLP_TOKEN/_HOST: optional, same as every other app (via
# clis/secrets' TELEMETRY_OPTIONAL) -- feeds the 15-min heartbeat
# (heartbeat.sh) via the compiled `logger` CLI, not @lib/logging directly
# (this container has no persistent Node process to host an OTel SDK in).

# T3 Code (github.com/pingdotgg/t3code) -- an independent, parallel remote
# control surface for this same container: the T3 Code mobile/web/desktop
# app drives `opencode`/`claude`/`codex` here directly, instead of only
# through remote-chat-agent. Not secret. See README.md's "T3 Code remote
# access" section for the full setup and the tailnet-only exposure
# decision (T3CODE_TAILSCALE_SERVE is deliberately NOT used here -- `app`
# has no `tailscale` CLI of its own to drive it, see t3code-serve.sh).
#
# Set to false to disable without a rebuild -- entrypoint.sh skips
# launching t3code-serve entirely when false (see README.md's "Disabling /
# rollback" section). Redeploy always provisions this file fresh from the
# exact commit the image tag names (see vm-ops-api's src/domain/provisionRef.ts
# and src/api/routes/redeploy.ts), so flipping this back to false and redeploying is
# a real, immediate kill switch, not just a local default.
AGENT_SHELL_T3CODE_ENABLED=true
# Pinned exact releases, never `latest` -- see t3code-serve.sh's own
# comment for why an unattended restart target must not self-upgrade.
# Confirmed current latest at the time this was added: npm's `t3` package,
# `curl -s https://registry.npmjs.org/t3/latest` to check for a newer one.
AGENT_SHELL_T3CODE_VERSION=0.0.35
# T3 Code's server requires node ^22.16 || ^23.11 || >=24.10, which the
# repo-wide mise.toml pin (22.14.0) fails -- this is a SECOND, independent
# node version installed via `mise` (t3code-serve.sh's own `mise exec`),
# never the toolchain-wide default. 24.13.1 matches this monorepo's own
# root package.json engines pin and its vendored @types/node version.
AGENT_SHELL_T3CODE_NODE_VERSION=24.13.1
AGENT_SHELL_T3CODE_PORT=3773
