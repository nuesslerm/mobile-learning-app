# Non-secret config (COMMITTED). Runtime `.env` = this + vault secrets via
#   wf secret sync-env --for vm-ops-api --base .env.defaults --out .env
# Secrets (from the vault, NEVER here): VM_OPS_API_AUTH_TOKEN -- this app's OWN
#   bearer token (NOT VM_GATEWAY_AUTH_SEED: that one only gates vm-gateway's public
#   Funnel; this app has a second ingress path, the tailnet directly, that needs its
#   own separate gate -- see backend/vm-ops-api/core/src/domain/auth.rs and
#   VM_OPS_API_AUTH_TOKEN's registry entry). BETTERSTACK_OTLP_TOKEN (optional),
#   VM_PROVISION_GITHUB_TOKEN (optional) -- fine-grained PAT, Contents=Read ONLY on this
#   one repo, used ONLY by /services/:app/redeploy's first-time provisioning to read
#   raw.githubusercontent.com config files (this repo is private, so that 404s without
#   it). Deliberately narrower than GITHUB_TOKEN (remote-chat-agent's clone/push/PR
#   credential) -- provisioning has no business holding write/PR/actions scope.
# HOST_LABEL is per-VM and appended by deploy.sh, not set here. TS_VM_AUTH_KEY
# is required (vault secret) -- this app joins the tailnet like every other app now;
# vm-gateway is the public-facing surface, not this app's own Caddy sidecar (removed).
# BETTERSTACK_OTLP_HOST is non-secret but per-source (not per-VM), so it's a real
# placeholder here rather than vault-resolved -- same pattern other backends use for
# tailnet URLs. Override with the real value in each VM's .env.local once known
# (BetterStack -> Telemetry -> Sources -> the backend/CLI OTLP source -> ingest host).
# /debug/ping degrades to betterstack:{sent:false} until both this and the token are set.
# Left UNSET deliberately: a placeholder here is worse than nothing. It is
# non-empty, so it reads as configured and the OTLP exporter builds an invalid
# URL from it. Uncomment with the REAL host once the source exists:
# BETTERSTACK_OTLP_HOST=<your-source>.betterstackdata.com

# The CI port: a second listener that serves only what a CI job needs, with its own seed (VM_OPS_API_CI_AUTH_TOKEN, a vault
# secret). Port 8080 stays the admin port. The tailnet policy (infra/tailscale/policy.hujson) says who reaches which.
CI_PORT=8081

# Non-secret (a public key) -- real, committed value, not a placeholder:
# verifies the Ed25519 signature layer (see backend/vm-ops-api/core/src/domain/auth.rs).
# PEM with real newlines escaped as literal
# \n. The matching private key lives in the vault as
# VM_GATEWAY_REQUEST_SIGNING_PRIVATE_KEY -- client-side only, never delivered to
# any VM's own .env (see clis/secrets/src/data/registry.json's own entry).
VM_GATEWAY_REQUEST_SIGNING_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEALR6KRz7h5oSpwB8bunw03Lw1srMBiz1A13drhIgDz/U=\n-----END PUBLIC KEY-----\n

# Host paths, test seams only: left unset on the VM, so the defaults hold. The
# tests point them at a fake Engine socket and a temp proc tree.
#   DOCKER_SOCKET (default /var/run/docker.sock) -- the Docker Engine API socket.
#   PROC_ROOT (default /proc) -- /stats reads meminfo and loadavg under it, build
#     admission reads pressure/{io,memory,cpu}.
