# Non-secret config (COMMITTED). Runtime `.env` on the VM = this file plus the vault secrets, assembled at provision time by
# vm-ops-api's redeploy:
#   wf secret sync-env --for libs-proxy --base .env.defaults --out .env
#
# Secrets (from the vault, NEVER here): LIBS_READ_PAR_URL, the read link of the `libs/` prefix, and TS_VM_AUTH_KEY, the
# tailscale sidecar's auth key.
#
# This file existing at all is what the provisioning step fetches from the provision ref before it runs `docker compose up`.

# The port inside the container; published on the tailnet through the sidecar, not on the host.
PORT=8793

# The URL the sparse index and every Cargo.lock name for this service: its tailnet name and port, with no secret in it.
LIBS_PROXY_BASE_URL=http://libs-proxy:8793

# Which image the compose file pulls; a redeploy passes ?tag=sha-<short> and vm-ops-api overrides IMAGE_TAG with it.
IMAGE_NAMESPACE=nuesslerm
IMAGE_TAG=latest
