{
  "method": "git.init",
  "exchanges": [
    {
      "name": "makes a repository in a directory below the root",
      "before": [
        {
          "id": 90,
          "method": "file.mkdir",
          "params": {
            "workspace": "w1",
            "path": "projects/p",
            "parents": true
          }
        }
      ],
      "request": {
        "id": 1,
        "method": "git.init",
        "params": {
          "workspace": "w1",
          "path": "projects/p",
          "initial_branch": "main"
        }
      },
      "response": {
        "id": 1,
        "result": {
          "path": "projects/p",
          "branch": "main"
        }
      },
      "actions": [
        "git_init"
      ]
    },
    {
      "name": "writes the first files and commits them",
      "before": [
        {
          "id": 90,
          "method": "file.mkdir",
          "params": {
            "workspace": "w1",
            "path": "projects/p",
            "parents": true
          }
        }
      ],
      "request": {
        "id": 1,
        "method": "git.init",
        "params": {
          "workspace": "w1",
          "path": "projects/p",
          "initial_branch": "main",
          "files": [
            {
              "path": "README.md",
              "content": "# p\n"
            }
          ],
          "message": "Initial commit"
        }
      },
      "response": {
        "id": 1,
        "result": {
          "path": "projects/p",
          "branch": "main",
          "commit": "<volatile>"
        }
      },
      "actions": [
        "git_init"
      ],
      "volatile": [
        "/result/commit"
      ]
    },
    {
      "name": "a directory that is not there is refused",
      "request": {
        "id": 1,
        "method": "git.init",
        "params": {
          "workspace": "w1",
          "path": "no/such"
        }
      },
      "response": {
        "id": 1,
        "error": {
          "code": "NOT_FOUND",
          "message": "no/such does not exist"
        }
      },
      "actions": [
        "git_init"
      ]
    },
    {
      "name": "a directory outside the root is refused",
      "request": {
        "id": 1,
        "method": "git.init",
        "params": {
          "workspace": "w1",
          "path": "../escape"
        }
      },
      "response": {
        "id": 1,
        "error": {
          "code": "PATH_OUTSIDE_ROOT",
          "message": "../escape is outside the root"
        }
      },
      "actions": [
        "git_init"
      ]
    },
    {
      "name": "a request with no workspace is refused before the executor is asked",
      "request": {
        "id": 1,
        "method": "git.init",
        "params": {
          "path": "projects/p"
        }
      },
      "response": {
        "id": 1,
        "error": {
          "code": "INVALID_PARAMS",
          "message": "workspace is required"
        }
      },
      "actions": []
    }
  ]
}
