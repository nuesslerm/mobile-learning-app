{
  "method": "terminal.sleeping",
  "exchanges": [
    {
      "name": "lists the workspaces that sleep with the shells each keeps",
      "before": [
        {
          "id": 1,
          "method": "terminal.open",
          "params": {
            "workspace": "w1",
            "terminal": "t1"
          }
        },
        {
          "id": 1,
          "method": "terminal.sleep",
          "params": {
            "workspace": "w1"
          }
        }
      ],
      "request": {
        "id": 1,
        "method": "terminal.sleeping",
        "params": {}
      },
      "response": {
        "id": 1,
        "result": {
          "sleeping": [
            {
              "workspace": "w1",
              "slept_at_ms": "<volatile>",
              "terminals": [
                {
                  "terminal": "t1",
                  "title": "t1",
                  "cwd": "<volatile>",
                  "cols": 80,
                  "rows": 24
                }
              ]
            }
          ]
        }
      },
      "actions": [],
      "volatile": [
        "/result/sleeping/0/slept_at_ms",
        "/result/sleeping/0/terminals/0/cwd"
      ]
    },
    {
      "name": "nothing sleeps until a workspace is put to sleep",
      "request": {
        "id": 1,
        "method": "terminal.sleeping",
        "params": {}
      },
      "response": {
        "id": 1,
        "result": {
          "sleeping": []
        }
      },
      "actions": []
    },
    {
      "name": "one workspace asked for that does not sleep is not listed",
      "before": [
        {
          "id": 1,
          "method": "terminal.open",
          "params": {
            "workspace": "w1",
            "terminal": "t1"
          }
        },
        {
          "id": 1,
          "method": "terminal.sleep",
          "params": {
            "workspace": "w1"
          }
        }
      ],
      "request": {
        "id": 1,
        "method": "terminal.sleeping",
        "params": {
          "workspace": "nowhere"
        }
      },
      "response": {
        "id": 1,
        "result": {
          "sleeping": []
        }
      },
      "actions": []
    }
  ]
}
