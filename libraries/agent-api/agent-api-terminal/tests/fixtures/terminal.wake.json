{
  "method": "terminal.wake",
  "exchanges": [
    {
      "name": "starts again the shells a sleep kept",
      "before": [
        {
          "id": 1,
          "method": "terminal.open",
          "params": {
            "workspace": "w1",
            "terminal": "t1"
          }
        },
        {
          "id": 1,
          "method": "terminal.sleep",
          "params": {
            "workspace": "w1"
          }
        }
      ],
      "request": {
        "id": 1,
        "method": "terminal.wake",
        "params": {
          "workspace": "w1"
        }
      },
      "response": {
        "id": 1,
        "result": {
          "workspace": "w1",
          "woken": [
            {
              "workspace": "w1",
              "terminal": "t1",
              "title": "t1",
              "cwd": "<volatile>",
              "cols": 80,
              "rows": 24,
              "status": "running",
              "exit_code": null,
              "pid": "<volatile>",
              "offset": "<volatile>",
              "base_offset": 0,
              "updated_at": "<volatile>"
            }
          ],
          "failed": []
        }
      },
      "actions": [
        "pty_list",
        "pty_open"
      ],
      "volatile": [
        "/result/woken/0/cwd",
        "/result/woken/0/pid",
        "/result/woken/0/offset",
        "/result/woken/0/updated_at"
      ]
    },
    {
      "name": "a workspace that did not sleep has nothing to wake",
      "request": {
        "id": 1,
        "method": "terminal.wake",
        "params": {
          "workspace": "w1"
        }
      },
      "response": {
        "id": 1,
        "result": {
          "workspace": "w1",
          "woken": [],
          "failed": []
        }
      },
      "actions": []
    },
    {
      "name": "a workspace is required",
      "request": {
        "id": 1,
        "method": "terminal.wake",
        "params": {}
      },
      "response": {
        "id": 1,
        "error": {
          "code": "INVALID_PARAMS",
          "message": "workspace is required"
        }
      },
      "actions": []
    }
  ]
}
