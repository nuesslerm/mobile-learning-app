{
  "method": "terminal.sleep",
  "exchanges": [
    {
      "name": "closes the shells of a workspace and keeps what starts them again",
      "before": [
        {
          "id": 1,
          "method": "terminal.open",
          "params": {
            "workspace": "w1",
            "terminal": "t1"
          }
        }
      ],
      "request": {
        "id": 1,
        "method": "terminal.sleep",
        "params": {
          "workspace": "w1"
        }
      },
      "response": {
        "id": 1,
        "result": {
          "workspace": "w1",
          "slept": [
            {
              "terminal": "t1",
              "title": "t1",
              "cwd": "<volatile>",
              "cols": 80,
              "rows": 24
            }
          ],
          "already": false
        }
      },
      "actions": [
        "pty_list",
        "pty_close"
      ],
      "volatile": [
        "/result/slept/0/cwd"
      ]
    },
    {
      "name": "a workspace with no shells sleeps with none kept",
      "request": {
        "id": 1,
        "method": "terminal.sleep",
        "params": {
          "workspace": "w1"
        }
      },
      "response": {
        "id": 1,
        "result": {
          "workspace": "w1",
          "slept": [],
          "already": false
        }
      },
      "actions": [
        "pty_list"
      ]
    },
    {
      "name": "a workspace nobody attached has no executor",
      "request": {
        "id": 1,
        "method": "terminal.sleep",
        "params": {
          "workspace": "nowhere"
        }
      },
      "response": {
        "id": 1,
        "error": {
          "code": "NO_EXECUTOR",
          "message": "no executor is attached for workspace nowhere"
        }
      },
      "actions": []
    },
    {
      "name": "a workspace is required",
      "request": {
        "id": 1,
        "method": "terminal.sleep",
        "params": {}
      },
      "response": {
        "id": 1,
        "error": {
          "code": "INVALID_PARAMS",
          "message": "workspace is required"
        }
      },
      "actions": []
    }
  ]
}
