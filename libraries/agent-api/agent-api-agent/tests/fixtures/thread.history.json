{
  "method": "thread.history",
  "exchanges": [
    {
      "name": "answers the events after a position, none for a thread that has run nothing",
      "before": [
        {
          "id": "setup-t-hist",
          "method": "thread.create",
          "params": {
            "thread": "t-hist"
          }
        }
      ],
      "request": {
        "id": "1",
        "method": "thread.history",
        "params": {
          "thread": "t-hist",
          "after_seq": 0,
          "limit": 50
        }
      },
      "response": {
        "id": "1",
        "result": {
          "events": [],
          "last_seq": 0,
          "more": false
        }
      }
    },
    {
      "name": "answers THREAD_NOT_FOUND for an id no thread has",
      "request": {
        "id": "2",
        "method": "thread.history",
        "params": {
          "thread": "nope"
        }
      },
      "response": {
        "id": "2",
        "error": {
          "code": "THREAD_NOT_FOUND",
          "message": "no thread has the id nope"
        }
      }
    },
    {
      "name": "refuses a page of no events",
      "request": {
        "id": "3",
        "method": "thread.history",
        "params": {
          "thread": "t-hist",
          "limit": 0
        }
      },
      "response": {
        "id": "3",
        "error": {
          "code": "INVALID_PARAMS",
          "message": "limit must be at least 1"
        }
      }
    }
  ]
}
