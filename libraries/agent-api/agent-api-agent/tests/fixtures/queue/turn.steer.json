{
  "method": "turn.steer",
  "exchanges": [
    {
      "name": "refuses a steer of a thread that runs no turn",
      "before": [
        {
          "id": "setup-create-t-st",
          "method": "thread.create",
          "params": {
            "thread": "t-st",
            "title": "Thread t-st",
            "workspace": "w1",
            "driver": "claudeAgent"
          }
        }
      ],
      "request": {
        "id": "1",
        "method": "turn.steer",
        "params": {
          "thread": "t-st",
          "prompt": "go left"
        }
      },
      "response": {
        "id": "1",
        "error": {
          "code": "NO_TURN",
          "message": "thread t-st has no running turn"
        }
      }
    },
    {
      "name": "answers THREAD_NOT_FOUND for an id no thread has",
      "request": {
        "id": "2",
        "method": "turn.steer",
        "params": {
          "thread": "nope",
          "prompt": "go left"
        }
      },
      "response": {
        "id": "2",
        "error": {
          "code": "THREAD_NOT_FOUND",
          "message": "no thread has the id nope"
        }
      }
    },
    {
      "name": "refuses a steer that names both a prompt and an item",
      "request": {
        "id": "3",
        "method": "turn.steer",
        "params": {
          "thread": "t-st",
          "prompt": "p",
          "item": "q1"
        }
      },
      "response": {
        "id": "3",
        "error": {
          "code": "INVALID_PARAMS",
          "message": "name exactly one of prompt and item"
        }
      }
    }
  ]
}
