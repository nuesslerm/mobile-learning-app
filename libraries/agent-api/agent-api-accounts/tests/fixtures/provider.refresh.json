{
  "method": "provider.refresh",
  "exchanges": [
    {
      "name": "refreshes one provider and answers the list",
      "request": {
        "id": 1,
        "method": "provider.refresh",
        "params": {
          "provider": "codex"
        }
      },
      "response": {
        "id": 1,
        "result": {
          "providers": [
            {
              "provider": "opencode",
              "status": "signed_out",
              "selected": false,
              "auth_methods": [
                "paste"
              ]
            },
            {
              "provider": "claudeAgent",
              "status": "signed_out",
              "selected": false,
              "auth_methods": [
                "paste"
              ]
            },
            {
              "provider": "codex",
              "status": "signed_out",
              "selected": false,
              "auth_methods": [
                "device_code"
              ]
            }
          ],
          "selected": null
        }
      }
    },
    {
      "name": "a provider that is none is refused",
      "request": {
        "id": 1,
        "method": "provider.refresh",
        "params": {
          "provider": "gemini"
        }
      },
      "response": {
        "id": 1,
        "error": {
          "code": "UNKNOWN_PROVIDER",
          "message": "gemini is not a provider; the providers are opencode, claudeAgent, codex"
        }
      }
    }
  ]
}
