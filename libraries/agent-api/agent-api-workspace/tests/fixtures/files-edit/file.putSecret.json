{
  "method": "file.putSecret",
  "exchanges": [
    {
      "name": "writes a secret to a new file and answers the path and size, never the value",
      "request": {
        "params": {
          "workspace": "w1",
          "path": ".rca/secrets/api-key",
          "value": "sk-test-0000"
        },
        "id": 1,
        "method": "file.putSecret"
      },
      "response": {
        "result": {
          "path": ".rca/secrets/api-key",
          "bytes": 12
        },
        "id": 1
      },
      "actions": [
        "secret_file_put"
      ]
    },
    {
      "name": "refuses a path that exists, with the executor's own code, and does not repeat the value",
      "request": {
        "params": {
          "workspace": "w1",
          "path": ".env",
          "value": "new"
        },
        "id": 2,
        "method": "file.putSecret"
      },
      "response": {
        "error": {
          "code": "ALREADY_EXISTS",
          "message": ".env already exists"
        },
        "id": 2
      },
      "actions": [
        "secret_file_put"
      ]
    },
    {
      "name": "refuses a path outside the workspace's root",
      "request": {
        "params": {
          "workspace": "w1",
          "path": "../escape",
          "value": "x"
        },
        "id": 3,
        "method": "file.putSecret"
      },
      "response": {
        "error": {
          "code": "PATH_OUTSIDE_ROOT",
          "message": "../escape is outside the root"
        },
        "id": 3
      },
      "actions": [
        "secret_file_put"
      ]
    },
    {
      "name": "refuses a request that carries no value, before the executor is asked",
      "request": {
        "params": {
          "workspace": "w1",
          "path": "k"
        },
        "id": 4,
        "method": "file.putSecret"
      },
      "response": {
        "error": {
          "code": "INVALID_PARAMS",
          "message": "value is required"
        },
        "id": 4
      },
      "actions": []
    }
  ]
}
