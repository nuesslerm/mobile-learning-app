{
  "method": "file.write",
  "exchanges": [
    {
      "name": "replaces a file and says how many bytes were written",
      "request": {
        "params": {
          "workspace": "w1",
          "path": "a.txt",
          "content": "new\n"
        },
        "id": 1,
        "method": "file.write"
      },
      "response": {
        "result": {
          "bytes": 4
        },
        "id": 1
      },
      "actions": [
        "write_file"
      ]
    },
    {
      "name": "relays the executor's refusal of a path outside its root",
      "request": {
        "params": {
          "workspace": "w1",
          "path": "../outside.txt",
          "content": "x"
        },
        "id": 2,
        "method": "file.write"
      },
      "response": {
        "error": {
          "code": "PATH_OUTSIDE_ROOT",
          "message": "../outside.txt is outside the root"
        },
        "id": 2
      },
      "actions": [
        "write_file"
      ]
    },
    {
      "name": "needs the content as a string before it asks the executor",
      "request": {
        "params": {
          "workspace": "w1",
          "path": "a.txt"
        },
        "id": 3,
        "method": "file.write"
      },
      "response": {
        "error": {
          "code": "INVALID_PARAMS",
          "message": "content is required"
        },
        "id": 3
      },
      "actions": []
    }
  ]
}
