{
  "method": "thread.diff",
  "exchanges": [
    {
      "name": "shows the changes of one path of the workspace",
      "request": {
        "params": {
          "workspace": "w1",
          "path": "a.txt"
        },
        "id": 1,
        "method": "thread.diff"
      },
      "response": {
        "result": {
          "diff": "diff --git a/a.txt b/a.txt\nindex 5626abf..9a72323 100644\n--- a/a.txt\n+++ b/a.txt\n@@ -1 +1,2 @@\n one\n+more\n"
        },
        "id": 1
      },
      "actions": [
        "git_diff"
      ]
    },
    {
      "name": "relays the executor's refusal of a path outside its root",
      "request": {
        "params": {
          "workspace": "w1",
          "path": "../etc/passwd"
        },
        "id": 2,
        "method": "thread.diff"
      },
      "response": {
        "error": {
          "code": "PATH_OUTSIDE_ROOT",
          "message": "../etc/passwd is outside the root"
        },
        "id": 2
      },
      "actions": [
        "git_diff"
      ]
    }
  ]
}
