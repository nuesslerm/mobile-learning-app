{
  "action": "session_scan",
  "exchanges": [
    {
      "name": "lists a claude session with the facts its file holds, naming the file below ~",
      "setup": {
        "home": {
          ".claude/projects/-work-app/sess-1.jsonl": "{\"type\": \"summary\", \"summary\": \"Fix the build\"}\n{\"type\": \"user\", \"sessionId\": \"sess-1\", \"cwd\": \"/work/app\", \"gitBranch\": \"main\", \"timestamp\": \"2026-11-01T10:00:00Z\", \"message\": {\"role\": \"user\", \"content\": \"fix the build\"}}\n{\"type\": \"assistant\", \"timestamp\": \"2026-11-01T10:00:05Z\", \"message\": {\"role\": \"assistant\", \"model\": \"claude-sonnet\", \"content\": [{\"type\": \"text\", \"text\": \"done\"}]}}\n",
          ".claude/projects/-work-app/notes.txt": "not a session"
        }
      },
      "request": {
        "id": "v1",
        "tool": "session_scan",
        "args": {
          "agents": [
            "claude"
          ]
        }
      },
      "response": {
        "id": "v1",
        "ok": true,
        "result": {
          "sessions": [
            {
              "agent": "claude",
              "session_id": "sess-1",
              "path": "~/.claude/projects/-work-app/sess-1.jsonl",
              "title": "Fix the build",
              "cwd": "/work/app",
              "branch": "main",
              "model": "claude-sonnet",
              "created_at": "2026-11-01T10:00:00Z",
              "updated_at": "2026-11-01T10:00:05Z",
              "modified_ms": 0,
              "message_count": 2,
              "first_prompt": "fix the build",
              "last_prompt": "fix the build"
            }
          ],
          "truncated": false
        }
      },
      "volatile": [
        "/result/sessions/0/modified_ms"
      ]
    },
    {
      "name": "lists a codex session from its rollout file",
      "setup": {
        "home": {
          ".codex/sessions/2026/11/02/rollout-2026-11-02T09-00-00-cx-1.jsonl": "{\"type\": \"session_meta\", \"payload\": {\"id\": \"cx-1\", \"cwd\": \"/work/app\", \"timestamp\": \"2026-11-02T09:00:00Z\", \"git\": {\"branch\": \"dev\"}}}\n{\"type\": \"turn_context\", \"payload\": {\"model\": \"gpt-codex\"}}\n{\"type\": \"response_item\", \"payload\": {\"type\": \"message\", \"role\": \"user\", \"content\": [{\"type\": \"input_text\", \"text\": \"add a test\"}]}}\n{\"timestamp\": \"2026-11-02T09:01:00Z\", \"type\": \"response_item\", \"payload\": {\"type\": \"message\", \"role\": \"assistant\", \"content\": [{\"type\": \"output_text\", \"text\": \"added\"}]}}\n"
        }
      },
      "request": {
        "id": "v2",
        "tool": "session_scan",
        "args": {
          "agents": [
            "codex"
          ]
        }
      },
      "response": {
        "id": "v2",
        "ok": true,
        "result": {
          "sessions": [
            {
              "agent": "codex",
              "session_id": "cx-1",
              "path": "~/.codex/sessions/2026/11/02/rollout-2026-11-02T09-00-00-cx-1.jsonl",
              "title": "add a test",
              "cwd": "/work/app",
              "branch": "dev",
              "model": "gpt-codex",
              "created_at": "2026-11-02T09:00:00Z",
              "updated_at": "2026-11-02T09:01:00Z",
              "modified_ms": 0,
              "message_count": 2,
              "first_prompt": "add a test",
              "last_prompt": "add a test"
            }
          ],
          "truncated": false
        }
      },
      "volatile": [
        "/result/sessions/0/modified_ms"
      ]
    },
    {
      "name": "answers a home with no session files with an empty list",
      "setup": {
        "home": {
          "notes.txt": "x"
        }
      },
      "request": {
        "id": "v3",
        "tool": "session_scan",
        "args": {}
      },
      "response": {
        "id": "v3",
        "ok": true,
        "result": {
          "sessions": [],
          "truncated": false
        }
      }
    },
    {
      "name": "names the file's stem when a file says nothing about itself",
      "setup": {
        "home": {
          ".claude/projects/p/abc.jsonl": "garbage\n"
        }
      },
      "request": {
        "id": "v4",
        "tool": "session_scan",
        "args": {
          "agents": [
            "claude"
          ]
        }
      },
      "response": {
        "id": "v4",
        "ok": true,
        "result": {
          "sessions": [
            {
              "agent": "claude",
              "session_id": "abc",
              "path": "~/.claude/projects/p/abc.jsonl",
              "title": "abc",
              "modified_ms": 0,
              "message_count": 0
            }
          ],
          "truncated": false
        }
      },
      "volatile": [
        "/result/sessions/0/modified_ms"
      ]
    },
    {
      "name": "refuses a CLI that keeps no sessions here",
      "request": {
        "id": "v5",
        "tool": "session_scan",
        "args": {
          "agents": [
            "opencode"
          ]
        }
      },
      "response": {
        "id": "v5",
        "ok": false,
        "error": {
          "code": "INVALID_ARGS",
          "message": "`agents` names claude or codex, not \"opencode\""
        }
      }
    }
  ]
}
