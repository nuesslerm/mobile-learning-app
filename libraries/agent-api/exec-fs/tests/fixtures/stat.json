{
  "action": "stat",
  "exchanges": [
    {
      "name": "gives the kind, size and modification time of a file",
      "setup": {"files": {"a.txt": "hello"}},
      "request": {"id": "s1", "tool": "stat", "args": {"path": "a.txt"}},
      "response": {"id": "s1", "ok": true, "result": {"kind": "file", "size": 5, "modified_ms": 0}},
      "volatile": ["/result/modified_ms"]
    },
    {
      "name": "tells a directory by its kind",
      "setup": {"files": {"src/a.txt": "x"}},
      "request": {"id": "s2", "tool": "stat", "args": {"path": "src"}},
      "response": {"id": "s2", "ok": true, "result": {"kind": "dir", "size": 0, "modified_ms": 0}},
      "volatile": ["/result/size", "/result/modified_ms"]
    },
    {
      "name": "refuses a path that does not exist",
      "request": {"id": "s3", "tool": "stat", "args": {"path": "missing.txt"}},
      "response": {"id": "s3", "ok": false, "error": {"code": "NOT_FOUND", "message": "missing.txt does not exist"}}
    },
    {
      "name": "refuses a path outside the root",
      "request": {"id": "s4", "tool": "stat", "args": {"path": "../x"}},
      "response": {"id": "s4", "ok": false, "error": {"code": "PATH_OUTSIDE_ROOT", "message": "../x is outside the root"}}
    },
    {
      "name": "refuses a path that is not a string",
      "request": {"id": "s5", "tool": "stat", "args": {"path": 5}},
      "response": {"id": "s5", "ok": false, "error": {"code": "INVALID_ARGS", "message": "`path` must be a string"}}
    }
  ]
}
