{
  "action": "secret_file_put",
  "exchanges": [
    {
      "name": "writes the secret to a new file, making the parent directories, and answers the path and size, never the value",
      "request": {
        "id": "s1",
        "tool": "secret_file_put",
        "args": {
          "path": ".rca/secrets/api-key",
          "value": "sk-test-0000"
        }
      },
      "response": {
        "id": "s1",
        "ok": true,
        "result": {
          "path": ".rca/secrets/api-key",
          "bytes": 12
        }
      }
    },
    {
      "name": "refuses a path that exists and leaves the file as it was",
      "setup": {
        "files": {
          ".env": "KEEP"
        }
      },
      "request": {
        "id": "s2",
        "tool": "secret_file_put",
        "args": {
          "path": ".env",
          "value": "new"
        }
      },
      "response": {
        "id": "s2",
        "ok": false,
        "error": {
          "code": "ALREADY_EXISTS",
          "message": ".env already exists"
        }
      }
    },
    {
      "name": "refuses a path outside the root",
      "request": {
        "id": "s3",
        "tool": "secret_file_put",
        "args": {
          "path": "../escape",
          "value": "x"
        }
      },
      "response": {
        "id": "s3",
        "ok": false,
        "error": {
          "code": "PATH_OUTSIDE_ROOT",
          "message": "../escape is outside the root"
        }
      }
    },
    {
      "name": "refuses an empty value",
      "request": {
        "id": "s4",
        "tool": "secret_file_put",
        "args": {
          "path": "k",
          "value": ""
        }
      },
      "response": {
        "id": "s4",
        "ok": false,
        "error": {
          "code": "INVALID_ARGS",
          "message": "`value` must hold 1 to 16384 bytes"
        }
      }
    },
    {
      "name": "refuses a missing value",
      "request": {
        "id": "s5",
        "tool": "secret_file_put",
        "args": {
          "path": "k"
        }
      },
      "response": {
        "id": "s5",
        "ok": false,
        "error": {
          "code": "INVALID_ARGS",
          "message": "`value` must be a string"
        }
      }
    }
  ]
}
