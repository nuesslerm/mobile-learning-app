{
  "action": "artifact_read",
  "exchanges": [
    {
      "name": "reads a byte range of a file of the root, base64 encoded",
      "setup": {"files": {"notes.txt": "abcdef"}},
      "request": {"id": "r1", "tool": "artifact_read", "args": {"path": "notes.txt", "offset": 1, "length": 3}},
      "response": {"id": "r1", "ok": true, "result": {"data": "YmNk", "offset": 1, "bytes": 3, "total_bytes": 6, "eof": false}}
    },
    {
      "name": "reads to the end of the file",
      "setup": {"files": {"notes.txt": "abcdef"}},
      "request": {"id": "r2", "tool": "artifact_read", "args": {"path": "notes.txt", "offset": 4, "fingerprint": "d80bda3fbe244a0a"}},
      "response": {"id": "r2", "ok": true, "result": {"data": "ZWY=", "offset": 4, "bytes": 2, "total_bytes": 6, "eof": true}}
    },
    {
      "name": "refuses a read whose fingerprint is not the file's any more, with CHANGED",
      "setup": {"files": {"notes.txt": "abcdef"}},
      "request": {"id": "r3", "tool": "artifact_read", "args": {"path": "notes.txt", "fingerprint": "0000000000000001"}},
      "response": {"id": "r3", "ok": false, "error": {"code": "CHANGED", "message": "notes.txt changed since it was granted"}}
    },
    {
      "name": "refuses a read whose identity is not the file's any more, with CHANGED",
      "setup": {"files": {"notes.txt": "abcdef"}},
      "request": {"id": "r4", "tool": "artifact_read", "args": {"path": "notes.txt", "identity": "1:2:3:4.5:6.7"}},
      "response": {"id": "r4", "ok": false, "error": {"code": "CHANGED", "message": "notes.txt changed since it was granted"}}
    },
    {
      "name": "refuses a directory",
      "setup": {"files": {"d/a.txt": "x"}},
      "request": {"id": "r5", "tool": "artifact_read", "args": {"path": "d"}},
      "response": {"id": "r5", "ok": false, "error": {"code": "NOT_A_FILE", "message": "d is not a regular file"}}
    },
    {
      "name": "refuses an absolute path outside the places the executor was allowed",
      "request": {"id": "r6", "tool": "artifact_read", "args": {"path": "/etc/hostname"}},
      "response": {"id": "r6", "ok": false, "error": {"code": "PATH_OUTSIDE_ROOT", "message": "/etc/hostname is outside the root"}}
    },
    {
      "name": "refuses a path that is not a string",
      "request": {"id": "r7", "tool": "artifact_read", "args": {"path": 5}},
      "response": {"id": "r7", "ok": false, "error": {"code": "INVALID_ARGS", "message": "`path` must be a string"}}
    }
  ]
}
