{
  "method": "state.get",
  "exchanges": [
    {
      "name": "reads back a value kept for a device",
      "before": [
        {
          "id": "k",
          "method": "state.set",
          "params": {
            "scope": "phone-a",
            "key": "quickCommands",
            "value": [
              "git status",
              "ls"
            ]
          }
        }
      ],
      "request": {
        "id": 2,
        "method": "state.get",
        "params": {
          "scope": "phone-a",
          "key": "quickCommands"
        }
      },
      "response": {
        "id": 2,
        "result": {
          "value": [
            "git status",
            "ls"
          ]
        }
      }
    },
    {
      "name": "answers null for a device that kept nothing under the key",
      "before": [
        {
          "id": "k",
          "method": "state.set",
          "params": {
            "scope": "phone-a",
            "key": "quickCommands",
            "value": [
              "ls"
            ]
          }
        }
      ],
      "request": {
        "id": "3",
        "method": "state.get",
        "params": {
          "scope": "phone-b",
          "key": "quickCommands"
        }
      },
      "response": {
        "id": "3",
        "result": {
          "value": null
        }
      }
    },
    {
      "name": "refuses a request that names no key",
      "request": {
        "id": 4,
        "method": "state.get",
        "params": {
          "scope": "phone-a"
        }
      },
      "response": {
        "id": 4,
        "error": {
          "code": "INVALID_PARAMS",
          "message": "scope and key are required"
        }
      }
    }
  ]
}
