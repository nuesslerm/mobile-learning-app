{
  "method": "state.subscribe",
  "exchanges": [
    {
      "name": "answers a scope nobody wrote to with no values at seq 0",
      "request": {
        "id": 1,
        "method": "state.subscribe",
        "params": {
          "scope": "fixture-watch"
        }
      },
      "response": {
        "id": 1,
        "result": {
          "scope": "fixture-watch",
          "values": {},
          "seq": 0,
          "reset": false
        }
      }
    },
    {
      "name": "answers a caller ahead of the stream with a reset",
      "request": {
        "id": 2,
        "method": "state.subscribe",
        "params": {
          "scope": "fixture-watch",
          "after_seq": 9
        }
      },
      "response": {
        "id": 2,
        "result": {
          "scope": "fixture-watch",
          "values": {},
          "seq": 0,
          "reset": true
        }
      }
    },
    {
      "name": "refuses a request with no scope",
      "request": {
        "id": 3,
        "method": "state.subscribe",
        "params": {}
      },
      "response": {
        "id": 3,
        "error": {
          "code": "INVALID_PARAMS",
          "message": "scope is required"
        }
      }
    },
    {
      "name": "refuses an after_seq that is no number",
      "request": {
        "id": 4,
        "method": "state.subscribe",
        "params": {
          "scope": "fixture-watch",
          "after_seq": "x"
        }
      },
      "response": {
        "id": 4,
        "error": {
          "code": "INVALID_PARAMS",
          "message": "after_seq must be a non-negative integer"
        }
      }
    }
  ]
}
