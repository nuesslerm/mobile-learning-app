{
  "action": "git_init",
  "exchanges": [
    {
      "name": "makes a repository in a directory below the root, on the branch it is asked for",
      "setup": {"files": {"projects/keep.txt": "x"}},
      "request": {"id": "i1", "tool": "git_init", "args": {"path": "projects", "initial_branch": "main"}},
      "response": {"id": "i1", "ok": true, "result": {"path": "projects", "branch": "main"}}
    },
    {
      "name": "names another first branch when asked",
      "setup": {"files": {"projects/a/keep.txt": "x"}},
      "request": {"id": "i2", "tool": "git_init", "args": {"path": "projects/a", "initial_branch": "trunk"}},
      "response": {"id": "i2", "ok": true, "result": {"path": "projects/a", "branch": "trunk"}}
    },
    {
      "name": "refuses a directory that does not exist",
      "request": {"id": "i3", "tool": "git_init", "args": {"path": "no/such/dir"}},
      "response": {"id": "i3", "ok": false, "error": {"code": "NOT_FOUND", "message": "no/such/dir does not exist"}}
    },
    {
      "name": "refuses a path that is a file",
      "setup": {"files": {"a.txt": "not a directory"}},
      "request": {"id": "i4", "tool": "git_init", "args": {"path": "a.txt"}},
      "response": {"id": "i4", "ok": false, "error": {"code": "INVALID_ARGS", "message": "a.txt is not a directory"}}
    },
    {
      "name": "refuses a path outside the root",
      "request": {"id": "i5", "tool": "git_init", "args": {"path": "../escape"}},
      "response": {"id": "i5", "ok": false, "error": {"code": "PATH_OUTSIDE_ROOT", "message": "../escape is outside the root"}}
    },
    {
      "name": "refuses a first file that climbs out of the repository, before anything is made",
      "setup": {"files": {"projects/keep.txt": "x"}},
      "request": {"id": "i6", "tool": "git_init", "args": {"path": "projects", "files": [{"path": "../outside.txt", "content": "x"}]}},
      "response": {"id": "i6", "ok": false, "error": {"code": "INVALID_ARGS", "message": "`path` must be a path inside the repository's working tree"}}
    },
    {
      "name": "refuses a worktree: it makes a repository at its path",
      "request": {"id": "i7", "tool": "git_init", "args": {"path": ".", "worktree": "wt"}},
      "response": {"id": "i7", "ok": false, "error": {"code": "INVALID_ARGS", "message": "`worktree` is no argument of git_init: it makes a repository at `path`"}}
    },
    {
      "name": "refuses a branch name git could read as an option",
      "request": {"id": "i8", "tool": "git_init", "args": {"path": ".", "initial_branch": "--bare"}},
      "response": {"id": "i8", "ok": false, "error": {"code": "INVALID_ARGS", "message": "`initial_branch` must be a branch name"}}
    }
  ]
}
