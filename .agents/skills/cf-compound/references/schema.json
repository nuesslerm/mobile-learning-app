{
  "$comment": "Frontmatter contract for docs/solutions entries, vendored from compound-engineering's ce-compound schema.yaml (2026-09-03) and trimmed to what this corpus uses. problem_type picks the track; component and root_cause are open vocabulary (corpus-first: reuse the spelling existing docs use for the area or the cause).",
  "tracks": {
    "bug": [
      "build_error",
      "test_failure",
      "runtime_error",
      "performance_issue",
      "database_issue",
      "security_issue",
      "ui_bug",
      "integration_issue",
      "logic_error"
    ],
