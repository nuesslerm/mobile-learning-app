  "yamlSafety": "Top-level scalar values must not contain an unquoted ' #' (YAML comment, silently truncates) or ': ' (nested mapping); array items starting with ` [ * & ! | > % @ ? or containing ': ' are wrapped in double quotes; the frontmatter is delimited by a line that is exactly ---."
}
