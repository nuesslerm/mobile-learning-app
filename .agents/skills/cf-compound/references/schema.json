      "documentation_gap",
      "workflow_issue",
      "developer_experience",
      "architecture_pattern",
      "design_pattern",
      "tooling_decision",
      "convention"
    ]
  },
  "required": ["title", "date", "category", "module", "problem_type", "component", "severity", "tags"],
  "bugRequired": ["symptoms", "root_cause", "resolution_type"],
