# Non-secret config (COMMITTED). Runtime `.env` = this + vault secrets via
#   wf secret sync-env --for remote-chat-agent --base .env.defaults --out .env
# Secrets (from the vault, NEVER here): TS_VM_AUTH_KEY, OPENCODE_GO_API_KEY,
#   CLAUDE_CODE_OAUTH_TOKEN, VNC_AUTH_TRIGGER_SECRET, VNC_AUTH_OWNER_CHAT_ID,
#   VNC_AUTH_OWNER_NOTIFY_SECRET
PORT=8787
NODE_ENV=development
# Browser origins allowed to call this API cross-origin (comma-separated).
# localhost on any port is always allowed, so the local web build and the
# Playwright export server work without listing every port. Everything else is
# explicit on purpose: most routes here have no auth check, so a wildcard would
# let any page a tailnet user visits drive this agent (src/lib/corsMiddleware.ts).
CHAT_AGENT_ALLOWED_ORIGINS=https://nuesslerm.github.io
# Prebuilt image coordinates, interpolated by docker-compose.prod.yml. The images
# are PUBLIC, so a pull needs no registry credential on the host. Pin IMAGE_TAG to
# a `sha-<short>` from the Build images workflow for a reproducible deploy or a
# rollback; `latest` tracks the newest build of the default branch.
IMAGE_NAMESPACE=nuesslerm
IMAGE_TAG=latest
# `opencode serve` sidecar image (backend/remote-chat-agent/opencode-server).
# Empty = the same tag as the agent (IMAGE_TAG), so a release ships the
# opencode-server whose baked server-config.json carries the agents the
# planner asks for (voice-planner). Set it to pin the sidecar independently.
OPENCODE_IMAGE_TAG=
# Which agent-CLI backend serves chat turns. MUST be present in the image: the
# image ships only the backends named by the Dockerfile's AGENT_CLIS build arg
# (default `opencode`), and the startup gate refuses to boot on a mismatch rather
# than failing on the first turn. See src/config/agentClis.ts.
AGENT_CLI=opencode
# The default model `routes/chat.ts`'s resolveCompatibleModel falls back to
# when a request carries no explicit model override (the normal case for
# every real caller -- the bot and the web UI both omit `model` unless the
# user has picked one). Left unset, EVERY unmodel'd turn silently fell
# through to opencode server's own built-in default model/provider instead
# of the one this deploy's OPENCODE_GO_API_KEY actually authenticates for --
# confirmed live: a direct `opencode run -m opencode-go/deepseek-v4.1-flash`
# with the exact same stored key succeeds, but a real /api/chat turn with no
# model field fails with "opencode session error: invalid api key" (see
# known-gaps.md #0). Must match a model this deploy's provider key is valid
# for -- kept in sync with config/models.ts's MODEL_TEXT default by hand,
# since the two serve different call sites and were never unified.
OPENCODE_DEFAULT_MODEL=opencode-go/deepseek-v4.1-flash
# The voice-edit planner's model. Benchmarked 2026-09-14 over 45 planner turns
# per model (docs/audits/2026-09-14-voice-edit-latency-data.md §10): kimi
# highspeed 15/15 compiling, p50 2.4 s, p90 2.9 s; deepseek-v4.1-flash hung past
# the 45 s turn budget on 5 turns.
OPENCODE_TEXT_MODEL=kimi-code-plan-global/kimi-for-coding-highspeed

# U6a reactive-interrupt (see src/lib/authRecovery.ts): where the shared VNC
# auth-session listener lives on the tailnet, by MagicDNS name (same reasoning
# as SERVER_URL above). VNC_AUTH_OWNER_NOTIFY_URL is unset since the Telegram
# bot that served /owner-notify was deleted, which keeps the mechanism inert
# (createOpencodeAuthRecovery's env gate) until a new owner-DM route exists.
VNC_AUTH_LISTENER_URL=http://vnc-auth.taila61461.ts.net:8795

# Codex's real credential lives under the shared HOME (/workspace/home) this
# service and agent-shell both mount -- not secret itself, just a path, so
# it's committed here rather than the vault. See docker-compose.prod.yml's
# CODEX_HOME comment for why this can't be left at codexGateway.ts's own
# temp-dir default in a real deploy.
CODEX_HOME=/workspace/home/.codex

# Non-secret, same value as every other backend/CLI service (one shared
# BetterStack OTLP source, KTD9) -- a real value belongs here (or in this
# VM's own .env.local), never resolved from the vault. Placeholder until
# filled in: BetterStack -> Telemetry -> Sources -> the backend/CLI OTLP
# source -> ingest host. Until then, the clis/telemetry subscriber logs to
# the console only (never fails to boot).
# Left UNSET deliberately: a placeholder here is worse than nothing. It is
# non-empty, so it reads as configured and the OTLP exporter builds an invalid
# URL from it. Uncomment with the REAL host once the source exists:
# BETTERSTACK_OTLP_HOST=<your-source>.betterstackdata.com

# Threads created over /ws without a cwd get this directory (shared workspace
# volume, valid inside the opencode container). See decider defaultCwd (g20).
RCA_DEFAULT_CWD=/workspace/home
