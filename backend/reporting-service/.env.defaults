# Non-secret config (COMMITTED). Runtime `.env` on the VM = this file plus the
# vault secrets, assembled at provision time by vm-ops-api's redeploy:
#   wf secret sync-env --for reporting-service --base .env.defaults --out .env
#
# Secrets (from the vault, NEVER here): TS_VM_AUTH_KEY -- the tailscale sidecar's
# auth key, the same one every other app on this host uses.
#
# This file existing at all is what the provisioning step fetches from the
# provision ref before it runs `docker compose up`; without it the redeploy
# fails with a raw.githubusercontent 404 and no container is ever created.

# The read API's port inside the container. It is published on the tailnet
# through the sidecar (network_mode: service:tailscale), not on the host, so
# this number is what `http://reporting-service:8791/...` resolves to and
# nothing else binds it.
PORT=8791
NODE_ENV=production

# Which image the compose file pulls. `latest` is the floating tag; a redeploy
# passes ?tag=sha-<short> and vm-ops-api overrides IMAGE_TAG with it, so the
# value here only decides what a bare `docker compose up` on the VM would take.
IMAGE_NAMESPACE=nuesslerm
IMAGE_TAG=latest

# The metrics live in the Always Free Autonomous Database, not in a file: HEALTH_REPORTS_ORDS_BASE_URL and
# HEALTH_REPORTS_ORDS_PASSWORD (secrets, from the vault) name it. REPORTING_STORAGE_BUDGET_BYTES, REPORTING_PRUNE_HIGH_PCT and
# REPORTING_PRUNE_LOW_PCT default to the free tier (20 GiB, 90 and 85 percent): the oldest samples are deleted only above the high mark.

# Not configurable here on purpose: the sampling cadences and the raw-sample
# retention window are constants in src/use-cases/scheduler.ts and the store,
# not environment reads. Declaring them in this file would look like knobs and
# silently do nothing -- change them in the source, where the numbers and the
# reasons for them live together.
# The CI runner reporting-service watches (VM_PROVISION_GITHUB_TOKEN reads it): this repository and the runner agent-shell registers as vm-<HOST_LABEL>.
REPORTING_GITHUB_REPO=nuesslerm/mobile-learning-app
REPORTING_RUNNER_NAME=vm-main
