{
  "name": "@backend/reporting-service",
  "description": "Samples the VM (containers, host, disk) into the Autonomous Database and serves it with the plan and run reports. The service is Rust (rs/, core/); its flow tests drive the router in-process (rs/tests/flow.rs).",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo run --release --locked -p reporting-service-rs --manifest-path Cargo.toml",
    "test:flow": "cargo test --locked -p reporting-service-rs --test flow --manifest-path Cargo.toml",
    "test:integration": "cargo test --locked -p reporting-service-rs --test integration --manifest-path Cargo.toml",
    "test:verify:deployed": "cargo test --locked -p reporting-service-rs --test deployed_verification --manifest-path Cargo.toml -- --ignored"
  },
  "nx": {
    "targets": {
      "test:flow": {
        "inputs": [
          "default",
          "^production",
          "^native",
          {
            "externalDependencies": []
          }
        ]
      },
      "test:integration": {
        "inputs": [
          "default",
          "^production",
          "^native",
          {
            "externalDependencies": []
          }
        ]
      }
    }
  }
}
