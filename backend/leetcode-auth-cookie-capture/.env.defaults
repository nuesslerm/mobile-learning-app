# Non-secret config (COMMITTED). Runtime `.env` = this + vault secrets via
#   wf secret sync-env --for leetcode-auth-cookie-capture --base .env.defaults --out .env
# Secrets (from the vault, NEVER here): LEETCODE_BACKEND_ADMIN_SECRET,
#   TS_VM_AUTH_KEY, TELEGRAM_NOTIFY_SECRET, LEETCODE_CAPTURE_TRIGGER_SECRET
LEETCODE_BACKEND_BASE_URL=http://leetcode-backend-local.<tailnet>.ts.net:8789
CAPTURE_MODE=remote
CAPTURE_NOVNC_PORT=6080
CAPTURE_TIMEOUT_MS=300000
CAPTURE_POLL_INTERVAL_MS=2000
TELEGRAM_NOTIFY_BASE_URL=http://leetcode-backend-local.<tailnet>.ts.net:8790
CAPTURE_LISTENER_PORT=8792
# Prebuilt image coordinates, interpolated by docker-compose.capture.yml. The
# images are PUBLIC, so a pull needs no registry credential on the host. Pin
# IMAGE_TAG to a `sha-<short>` from the Build images workflow for a reproducible
# deploy/rollback.
IMAGE_NAMESPACE=nuesslerm
IMAGE_TAG=latest
