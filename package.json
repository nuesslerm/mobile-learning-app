{
  "name": "expo-hello-world-app-2-workspace",
  "version": "1.0.0",
  "packageManager": "pnpm@11.5.2",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "bash .agents/setup.sh",
    "prepare": "node scripts/prepare.mjs",
    "submodule:init": "git submodule update --init --recommend-shallow --depth 1",
    "sync:agent-config": "wf agent-config sync",
    "sync:check": "wf agent-config sync --check",
    "arch:services": "ls-lint --config .ls-lint.yml && ast-grep scan --config backend/sgconfig.yml && ast-grep test --config backend/sgconfig.yml --skip-snapshot-tests",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings --ignore-pattern=frontend/**",
    "typecheck": "tsc --noEmit",
    "skills:install": "skills experimental_install",
    "audit": "pnpm audit --audit-level=high",
    "checks:post-land": "lefthook run post-land --all-files"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "@types/react": "catalog:",
    "@ast-grep/cli": "^0.45.3",
    "@babel/core": "catalog:",
    "@babel/traverse": "catalog:",
    "@lib/eslint-plugin-mobile-learn": "workspace:*",
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/node": "catalog:",
    "lefthook": "^2.1.6",
    "nx": "23.2.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "repomix": "^1.18.0",
    "skills": "^1.5.13",
    "smol-toml": "1.6.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-babel": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  },
  "nx": {}
}
