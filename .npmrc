# pnpm 11 does NOT read pnpm-specific settings from this file -- confirmed with
# `pnpm config get shamefully-hoist` returning undefined while the entry was
# present here. The hoisting config now lives in pnpm-workspace.yaml, which is
# where pnpm 11 reads it; see the comment there for what broke when it was
# discovered. Only genuinely npm-level settings belong in this file.

strict-ssl=true
