{
  "schema": "mimic-rules/1",
  "rules": [
    {
      "kind": "uuid-ordinal"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/antigravity/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/claude/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/codex/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/cursor/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/gemini/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/grok/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/kimi/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/minimax/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/opencodeGo/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/zcode/updatedAt",
      "placeholder": "<volatile:updatedAt>",
      "interaction": "orca-accounts.list"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/scannedAt",
      "placeholder": "<volatile:scannedAt>",
      "interaction": "orca-skills.discover"
    },
    {
      "kind": "volatile-number",
      "keys": {
        "updatedAt": "<volatile:updatedAt>"
      }
    },
    {
      "kind": "token",
      "pattern": "\\baccounts\\-[0-9a-f]{16}\\-1\\b",
      "placeholder": "<volatile:hex16>"
    },
    {
      "kind": "token",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(?:Z|[+-][0-9]{2}:[0-9]{2})",
      "placeholder": "<ts>"
    },
    {
      "kind": "token",
      "pattern": "\\bnotifications\\-[0-9a-f]{16}\\-1\\b",
      "placeholder": "<volatile:hex16>"
    },
    {
      "kind": "token",
      "pattern": "\\bruntime\\-client\\-events\\-[0-9a-f]{16}\\-1\\b",
      "placeholder": "<volatile:hex16>"
    },
    {
      "kind": "volatile-number",
      "keys": {
        "firstInteractedAt": "<volatile:firstInteractedAt>"
      }
    }
  ]
}
