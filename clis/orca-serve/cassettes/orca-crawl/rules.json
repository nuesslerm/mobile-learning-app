      "placeholder": "<volatile>",
      "interaction": "orca-accounts.list-valid-min"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/gemini/updatedAt",
      "placeholder": "<volatile>",
      "interaction": "orca-accounts.list-valid-min"
    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/rateLimits/grok/updatedAt",
      "placeholder": "<volatile>",
