    },
    {
      "kind": "pointer",
      "pointer": "/steps/1/payload/result/group/updatedAt",
      "placeholder": "<volatile>",
      "interaction": "orca-projectGroup.create-valid-min"
    },
    {
      "kind": "volatile-number",
      "keys": {
        "scannedAt": "<volatile:scannedAt>"
      }
    },
    {
      "kind": "token",
      "pattern": "/tmp/r[0-9a-z]+/stage/clis/[a-z0-9-]+/cassettes/[a-z0-9-]+",
      "placeholder": "<set-dir>"
    }
