# Non-secret config of `orca-serve serve` (compose service `app` of docker-compose.prod.yml). Vault secrets it needs, via
# `wf secret sync-env --for orca-serve --base .env.defaults`: ORCA_RCA_BEARER (a device bearer of rca's agent API).
ORCA_PORT=6768
ORCA_LABEL=rca
# rca's agent API on the tailnet; orca-serve holds no workspace name (a phone's project and worktree calls name them per request)
ORCA_RCA_URL=http://remote-chat-agent-prod:8787
