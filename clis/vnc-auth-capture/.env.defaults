# Non-secret config (COMMITTED). Runtime `.env` = this + vault secrets via
#   wf secret sync-env --for vnc-auth-session --base .env.defaults --out .env
# Secrets (from the vault, NEVER here): TS_VM_AUTH_KEY,
#   VNC_AUTH_TRIGGER_SECRET, VNC_AUTH_OWNER_CHAT_ID, VNC_AUTH_DESKTOP_PASSWORD,
#   VM_OPS_API_AUTH_TOKEN (bearer token for vm-ops-api's
#   POST /agent-shell/credentials, consumed by the agent-shell-relay --
#   distinct from VM_GATEWAY_AUTH_SEED, which only gates vm-gateway's
#   own public Funnel),
#   LEETCODE_BACKEND_ADMIN_SECRET (guards leetcode-backend's
#   POST /api/leetcode/session, where the captured cookie is stored)
SECRETS_BACKEND=bitwarden
VNC_AUTH_LISTENER_PORT=8795
VNC_AUTH_SERVE_BACKEND=https+insecure://127.0.0.1:3001
VNC_AUTH_VNC_USER=test
# VNC_AUTH_LINK_BASE_URL is auto-derived from `tailscale status`; set only to override.

# Where the leetcode adapter stores its captured session cookie. Resolvable
# because this container shares the tailscale sidecar's netns with
# TS_ACCEPT_DNS=true, so MagicDNS short names work (same as the agent-shell
# relay's vm-ops-api-main).
#
# NOTE the hostname can drift: tailscale appends a -N suffix when a device
# rejoins while the old node still holds the name, which is how
# agent-shell-main became agent-shell-main-2 and broke every caller with a
# SOCKS failure that reads like a dead proxy. Check `tailscale status` if
# leetcode capture starts failing to reach the backend.
# Unset this to stop offering leetcode as a tool entirely -- the adapter is
# only registered when both this and LEETCODE_BACKEND_ADMIN_SECRET are present.
LEETCODE_BACKEND_BASE_URL=http://leetcode-backend-prod-2:8789
