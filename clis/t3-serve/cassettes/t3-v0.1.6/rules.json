{
  "schema": "mimic-rules/1",
  "rules": [
    {
      "kind": "token",
      "pattern": "\\b[A-Za-z0-9_-]{24,}\\.[A-Za-z0-9_-]{16,}\\b",
      "placeholder": "<signed-token>"
    },
    {
      "kind": "uuid-ordinal"
    },
    {
      "kind": "timestamp",
      "keys": [],
      "placeholder": "<ts>"
    },
    {
      "kind": "secret-key",
      "keys": {
        "access_token": "<access-token>",
        "credential": "<pairing-credential>",
        "csrfToken": "<csrf>",
        "subject_token": "<pairing-credential>",
        "ticket": "<ws-ticket>",
        "token": "<pairing-credential>",
        "wsTicket": "<ws-ticket>"
      }
    },
    {
      "kind": "sequence",
      "keys": [
        "sequence",
        "snapshotSequence",
        "afterSequence",
        "latestSequence"
      ],
      "placeholder": "<seq>"
    },
    {
      "kind": "volatile-number",
      "keys": {
        "expires_in": "<expires-in>",
        "fiberId": "<fiber>",
        "pid": "<pid>"
      }
    },
    {
      "kind": "volatile-string",
      "keys": {
        "spanId": "<trace>",
        "traceId": "<trace>"
      }
    },
    {
      "kind": "drop-header",
      "names": [
        "date",
        "host",
        "connection",
        "keep-alive",
        "content-length",
        "etag",
        "last-modified",
        "transfer-encoding",
        "user-agent",
        "accept-encoding",
        "accept-language",
        "sec-websocket-key",
        "sec-websocket-accept",
        "sec-websocket-version",
        "sec-fetch-mode",
        "sec-fetch-site",
        "sec-fetch-dest",
        "upgrade"
      ]
    }
  ]
}
