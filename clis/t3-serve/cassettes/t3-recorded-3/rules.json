{
 "schema": "mimic-rules/1",
 "rules": [
  {
   "kind": "token",
   "pattern": "\\b[0-9a-f]{32}\\b",
   "placeholder": "<trace>"
  },
  {
   "kind": "token",
   "pattern": "t3_session_[0-9]+_[0-9a-f]{12}",
   "placeholder": "t3_session_<port>_<hash>"
  },
  {
   "kind": "token",
   "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z",
   "placeholder": "<ts>"
  },
  {
   "kind": "token",
   "pattern": "subject_token=[A-Z2-9]{12}",
   "placeholder": "subject_token=<pairing-credential>"
  },
  {
   "kind": "token",
   "pattern": "eyJ[A-Za-z0-9_-]{20,}(\\.[A-Za-z0-9_-]+)?",
   "placeholder": "<signed-token>"
  },
  {
   "kind": "token",
   "pattern": "\\b[A-Za-z0-9_-]{24,}\\.[A-Za-z0-9_-]{16,}\\b",
   "placeholder": "<signed-token>"
  },
  {
   "kind": "uuid-ordinal"
  },
  {
   "kind": "timestamp",
   "keys": [],
   "placeholder": "<ts>"
  },
  {
   "kind": "secret-key",
   "keys": {
    "access_token": "<access-token>",
    "credential": "<pairing-credential>",
    "csrfToken": "<csrf>",
    "subject_token": "<pairing-credential>",
    "ticket": "<ws-ticket>",
    "token": "<pairing-credential>",
    "wsTicket": "<ws-ticket>"
   }
  },
  {
   "kind": "sequence",
   "keys": [
    "sequence",
    "snapshotSequence",
    "afterSequence",
    "latestSequence"
   ],
   "placeholder": "<seq>"
  },
  {
   "kind": "volatile-number",
   "keys": {
    "expires_in": "<expires-in>",
    "fiberId": "<fiber>",
    "pid": "<pid>"
   }
  },
  {
   "kind": "volatile-string",
   "keys": {
    "spanId": "<trace>",
    "traceId": "<trace>"
   }
  },
  {
   "kind": "drop-header",
   "names": [
    "date",
    "host",
    "connection",
    "keep-alive",
    "content-length",
    "etag",
    "last-modified",
    "transfer-encoding",
    "user-agent",
    "accept-encoding",
    "accept-language",
    "sec-websocket-key",
    "sec-websocket-accept",
    "sec-websocket-version",
    "sec-fetch-mode",
    "sec-fetch-site",
    "sec-fetch-dest",
    "upgrade"
   ]
  },
  {
   "kind": "pointer",
   "pointer": "/steps/10/payload/exit/value/revision",
   "placeholder": "<volatile:revision>",
   "interaction": "t3-rpc-device.configure"
  },
  {
   "kind": "pointer",
   "pointer": "/steps/10/payload/values/0/attribution/entries/0/count",
   "placeholder": "<volatile:telemetry>",
   "interaction": "t3-rpc-subscribeResourceTelemetry"
  },
  {
   "kind": "pointer",
   "pointer": "/steps/10/payload/values/0/attribution/entries/0/durationMs",
   "placeholder": "<volatile:telemetry>",
   "interaction": "t3-rpc-subscribeResourceTelemetry"
  },
  {
   "kind": "pointer",
   "pointer": "/steps/10/payload/values/0/attribution/entries/0/logicalWriteBytes",
   "placeholder": "<volatile:telemetry>",
   "interaction": "t3-rpc-subscribeResourceTelemetry"
  },
  {
   "kind": "pointer",
   "pointer": "/steps/10/payload/values/0/groups/allT3/currentCpuPercent",
   "placeholder": "<volatile:telemetry>",
   "interaction": "t3-rpc-subscribeResourceTelemetry"
  },
  {
   "kind": "pointer",
   "pointer": "/steps/10/payload/values/0/groups/allT3/currentRssBytes",
   "placeholder": "<volatile:telemetry>",
   "interaction": "t3-rpc-subscribeResourceTelemetry"
  },
  {
   "kind": "pointer",
   "pointer": "/steps/10/payload/values/0/groups/allT3/peakRssBytes",
   "placeholder": "<volatile:telemetry>",
   "interaction": "t3-rpc-subscribeResourceTelemetry"
  },
  {
   "kind": "pointer",
   "pointer": "/steps/10/payload/values/0/groups/allT3/processCount",
   "placeholder": "<volatile:telemetry>",
   "interaction": "t3-rpc-subscribeResourceTelemetry"
  },
  {
   "kind": "pointer",
   "pointer": "/steps/10/payload/values/0/groups/allT3/processStarts",
   "placeholder": "<volatile:telemetry>",
   "interaction": "t3-rpc-subscribeResourceTelemetry"
  }
 ]
}
