# Non-secret config of `t3 serve` (compose service `app` of docker-compose.prod.yml). Vault secrets it needs, via
# `wf secret sync-env --for t3-serve --base .env.defaults`: T3_RCA_BEARER (a device bearer of rca's agent API).
T3_PORT=8797
T3_LABEL=rca
# rca's agent API on the tailnet, and the rca workspace whose executor works where the projects' files are
T3_RCA_URL=http://remote-chat-agent-prod:8787
T3_RCA_WORKSPACE=main
